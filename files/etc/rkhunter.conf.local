# rkhunter false positives that are known-good on Arch/Omarchy.
# Add your own only after checking them (see docs/08-triage.md).
SCRIPTWHITELIST=/usr/bin/egrep
SCRIPTWHITELIST=/usr/bin/fgrep
SCRIPTWHITELIST=/usr/bin/ldd
ALLOWHIDDENFILE=/etc/.updated
ALLOWHIDDENFILE=/usr/share/man/man5/.k5identity.5.gz
ALLOWHIDDENFILE=/usr/share/man/man5/.k5login.5.gz
# EasyEffects (LSP plugins) shared memory; harmless if you don't use EasyEffects
ALLOWDEVFILE="/dev/shm/lsp-catalog-*"
# sshd is disabled; OpenSSH's defaults are safe
ALLOW_SSH_ROOT_USER=unset
ALLOW_SSH_PROT_V1=2
